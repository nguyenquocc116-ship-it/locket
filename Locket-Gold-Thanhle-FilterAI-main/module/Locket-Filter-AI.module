#!name=Locket Filter AI by Thanh Lê
#!desc=Locket Gold + Video 45s + Photobooth + AI Filter + Unlock Unblur VIP
#!author=Thanh Lê (@thanhlh05)
#!homepage=https://github.com/thanhlh05/Locket-Gold-Thanhle-FilterAI

[Rule]
# Chặn QUIC/HTTP3 ép app fallback về HTTP/1.1 hoặc HTTP/2 để giải mã MITM
AND,((DOMAIN,firebaseremoteconfig.googleapis.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.revenuecat.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,api.locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN-SUFFIX,locketcamera.com),(PROTOCOL,UDP)),REJECT
AND,((DOMAIN,us-central1-locket-4252a.cloudfunctions.net),(PROTOCOL,UDP)),REJECT

[Header Rewrite]
# Xóa bỏ header cache chống lỗi 304 Not Modified
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del x-revenuecat-etag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del X-RevenueCat-ETag
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-none-match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-None-Match
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del if-modified-since
^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers) header-del If-Modified-Since

^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-none-match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-None-Match
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del if-modified-since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del If-Modified-Since
^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+ header-del x-goog-if-none-match

^https?:\/\/api\.locketcamera\.com\/.+ header-del if-none-match
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-None-Match
^https?:\/\/api\.locketcamera\.com\/.+ header-del if-modified-since
^https?:\/\/api\.locketcamera\.com\/.+ header-del If-Modified-Since

[Script]
# 1. Anti-Cache + RevenueCat Unlock Gold VIP
deleteHeader_RC = type=http-request,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/deleteHeader_RC.js,timeout=60

deleteHeader_Firebase = type=http-request,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+,script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/deleteHeader_Firebase.js,timeout=60

revenuecat = type=http-response,pattern=^https?:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers),script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/revenuecat.js,requires-body=true,max-size=-1,timeout=60

# 2. Remote Config (45s Video + Toàn bộ Filter Photobooth & Khung + Caption tùy chỉnh)
locket_rc = type=http-response,pattern=^https?:\/\/firebaseremoteconfig\.googleapis\.com\/.+,script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/locketfix.js,requires-body=true,max-size=-1,timeout=60

# 3. Photobooth + AI Filter Request (Reroute trực tiếp sang Cloudflare Worker bảo mật, không dùng 307 redirect tránh lỗi không thể áp dụng bộ lọc)
locket_pb_req = type=http-request,pattern=^https?:\/\/(us-central1-locket-4252a\.cloudfunctions\.net|api\.locketcamera\.com)\/generateFilteredImage,script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/locket_pb_req.js,requires-body=true,max-size=-1,timeout=60

# 4. Profile Mock + Filter & Moment Unblur Response
locket_change_profile = type=http-request,pattern=^https?:\/\/api\.locketcamera\.com\/changeProfileInfo,script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/locket_change_profile.js,timeout=60

locket_filter_resp = type=http-response,pattern=^https?:\/\/api\.locketcamera\.com\/.+,requires-body=true,max-size=-1,script-path=https://raw.githubusercontent.com/nguyenquocc116-ship-it/locket/refs/heads/main/Locket-Gold-Thanhle-FilterAI-main/scripts/locket_filter_resp.js,timeout=60

[Host]
# Chặn Realtime Remote Config tránh bị máy chủ ghi đè cấu hình Gold
firebaseremoteconfigrealtime.googleapis.com = 0.0.0.0

[MITM]
hostname = %APPEND% api.revenuecat.com, firebaseremoteconfig.googleapis.com, api.locketcamera.com, *.locketcamera.com, us-central1-locket-4252a.cloudfunctions.net, locket-vip.mhiep20077.workers.dev, locket-mod-backend.onrender.com
